// Panel oscuro de la bandeja. Lo compila build.rs (slint-build) y main.rs lo usa vía
// slint::include_modules!().

global Theme {
    out property <color> bg: #1d1d20;
    out property <color> border: #34343a;
    out property <color> text: #e6e6ea;
    out property <color> dim: #8d8d96;
    out property <color> accent: #4682dc;
    out property <color> hover: #ffffff12;
    out property <color> warning: #e5484d;
}

// Una capa de la mezcla tal como la muestra el panel.
export struct LayerItem {
    name: string,
    on: bool,
    volume: float,
}

component Separator inherits Rectangle {
    height: 9px;
    Rectangle {
        x: 6px;
        y: 4px;
        width: parent.width - 12px;
        height: 1px;
        background: Theme.border;
    }
}

component MenuRow inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <color> text-color: Theme.text;
    callback clicked;
    // Posición del clic dentro de la fila, para abrir el menú contextual ahí.
    callback right-clicked(length, length);
    height: 28px;
    border-radius: 5px;
    background: ta.has-hover ? Theme.hover : transparent;
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        pointer-event(e) => {
            if e.button == PointerEventButton.right && e.kind == PointerEventKind.up {
                root.right-clicked(self.mouse-x, self.mouse-y);
            }
        }
    }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;
        Text {
            text: root.icon;
            width: 14px;
            color: Theme.accent;
            font-size: 12px;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
        Text {
            text: root.text;
            color: root.text-color;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        @children
    }
}

component Toggle inherits Rectangle {
    in property <bool> on;
    width: 28px;
    height: 16px;
    border-radius: 8px;
    background: root.on ? Theme.accent : #ffffff26;
    animate background { duration: 120ms; }
    Rectangle {
        y: 2px;
        x: root.on ? root.width - self.width - 2px : 2px;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: white;
        animate x { duration: 120ms; easing: ease-out; }
    }
}

component PlayButton inherits Rectangle {
    in property <bool> playing;
    callback clicked;
    width: 30px;
    height: 30px;
    border-radius: 15px;
    background: ta.pressed ? Theme.accent.darker(0.25) : ta.has-hover ? Theme.accent.brighter(0.15) : Theme.accent;
    if root.playing: HorizontalLayout {
        alignment: center;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 3px;
        Rectangle { width: 3px; background: white; border-radius: 1px; }
        Rectangle { width: 3px; background: white; border-radius: 1px; }
    }
    if !root.playing: Path {
        x: 11px;
        y: 9px;
        width: 10px;
        height: 12px;
        commands: "M 0 0 L 10 6 L 0 12 Z";
        fill: white;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component VolumeSlider inherits Rectangle {
    in property <string> label;
    Text {
        text: root.label;
        x: parent.width - self.width - 6px;
        y: parent.height / 2  + 7px;
        color: Theme.dim;
        font-size: 10px;
    }
    in-out property <float> value;
    callback changed(float);
    min-height: 20px;
    horizontal-stretch: 1;

    function set-from(px: length) {
        root.value = clamp((px - 6px) / (root.width - 12px), 0, 1);
        root.changed(root.value);
    }

    Rectangle {
        x: 6px;
        y: (parent.height - self.height) / 2;
        width: parent.width - 12px;
        height: 4px;
        border-radius: 2px;
        background: #ffffff22;
    }
    Rectangle {
        x: 6px;
        y: (parent.height - self.height) / 2;
        width: (parent.width - 12px) * root.value;
        height: 4px;
        border-radius: 2px;
        background: Theme.accent;
    }
    Rectangle {
        width: 12px;
        height: 12px;
        border-radius: 6px;
        x: (parent.width - self.width) * root.value;
        y: (parent.height - self.height) / 2;
        background: ta.pressed || ta.has-hover ? #ffffff : #dcdce2;
    }
    ta := TouchArea {
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                root.set-from(self.mouse-x);
            }
        }
        moved => {
            if self.pressed {
                root.set-from(self.mouse-x);
            }
        }
        scroll-event(e) => {
            root.value = clamp(root.value + (e.delta-y > 0 ? 0.05 : -0.05), 0, 1);
            root.changed(root.value);
            accept
        }
    }
}

// Indicador de reproducción: tres barritas quietas que cambian de forma y color según
// el estado. Sonando: altas y desparejas en azul, como un ecualizador congelado. En
// pausa: bajas, parejas y grises. Es estático a propósito: animarlo costaba CPU con el
// panel abierto (con animation-tick() subía de ~1 % a ~8 %), y así cuesta cero.
component PlayingBars inherits Rectangle {
    in property <bool> active;
    width: 13px;
    height: 12px;

    for i in 3: Rectangle {
        x: i * 5px;
        width: 3px;
        height: root.active
            ? root.height * (i == 0 ? 0.55 : i == 1 ? 1.0 : 0.75)
            : root.height * 0.35;
        y: (root.height - self.height) / 2;
        border-radius: 1.5px;
        background: root.active ? Theme.accent : Theme.dim;
    }
}

component PrimaryButton inherits Rectangle {
    in property <string> text;
    callback clicked;
    height: 30px;
    border-radius: 6px;
    background: ta.pressed ? Theme.accent.darker(0.25) : ta.has-hover ? Theme.accent.brighter(0.15) : Theme.accent;
    Text {
        text: root.text;
        color: white;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Pantalla del primer inicio: pide elegir el volumen antes de usar la app, para que
// nunca arranque más fuerte de lo que la persona quiere.
component WelcomeView inherits VerticalLayout {
    in-out property <float> volume;
    callback volume-changed(float);
    callback done();
    padding: 8px;
    padding-top: 6px;
    spacing: 10px;

    Text {
        text: "Bienvenido";
        color: Theme.text;
        font-size: 15px;
        font-weight: 600;
    }
    Text {
        text: "Elige el volumen con el que quieres que funcione la app. Es reconfigurable más adelante.";
        color: Theme.dim;
        wrap: word-wrap;
    }
    HorizontalLayout {
        spacing: 10px;
        padding-top: 4px;
        padding-bottom: 4px;
        VolumeSlider {
            value <=> root.volume;
            changed(v) => { root.volume-changed(v); }
        }
        Text {
            text: round(root.volume * 100) + "%";
            width: 30px;
            color: Theme.text;
            vertical-alignment: center;
        }
    }
    PrimaryButton {
        text: "Listo";
        clicked => { root.done(); }
    }
}

export component Panel inherits Window {
    in property <string> version;
    // La mezcla: cada sonido de assets/ con su estado. `mix-label` lo arma main.rs para
    // el texto de arriba (el nombre si suena uno solo, "N sonidos" si son varios, vacío
    // si no hay ninguno prendido).
    in property <[LayerItem]> layers;
    in property <string> mix-label;
    in property <int> active-count;
    // Menú contextual de un sonido (clic derecho): cuál (-1 = cerrado) y dónde.
    in-out property <int> menu-layer: -1;
    in-out property <length> menu-x;
    in-out property <length> menu-y;
    in-out property <bool> playing;
    in-out property <float> volume: 0.5;
    in-out property <bool> autostart;
    // Dispositivos de salida: el índice 0 es "Predeterminado de Windows" y del 1 en
    // adelante son los de `devices`.
    in property <[string]> devices;
    in property <string> default-device-name;
    in-out property <int> current-device;
    in-out property <bool> devices-open;
    // Primer inicio: en vez del panel normal se muestra la bienvenida.
    in-out property <bool> welcome;
    out property <length> panel-width: 264px;

    callback toggle-play();
    callback volume-changed(float);
    callback toggle-layer(int);
    callback layer-volume-changed(int, float);
    callback remove-layer(int);
    callback select-device(int);
    callback add-audio();
    callback toggle-autostart();
    callback open-folder();
    callback about();
    callback quit();
    callback dismiss();
    callback welcome-done();
    // Estos dos no los dispara la interfaz: los invoca main.rs desde otros hilos (vía el
    // event loop), para enterarse de eventos sin tener que estar revisando cada tanto.
    // - output-lost: el dispositivo de salida se desconectó (con el número de salida
    //   abierta, para ignorar avisos de una que ya se reemplazó).
    // - tray-clicked: clic en el ícono de la bandeja (posición y tamaño del ícono).
    callback output-lost(int);
    callback tray-clicked(int, int, int, int);

    title: "Pluvia";
    no-frame: true;
    always-on-top: true;
    width: root.panel-width;
    height: content.preferred-height;
    background: Theme.bg;
    default-font-family: "Segoe UI";
    default-font-size: 12px;
    forward-focus: keys;

    keys := FocusScope {
        key-pressed(e) => {
            // Con el menú contextual abierto, Esc cierra solo el menú.
            if e.text == Key.Escape && root.menu-layer >= 0 {
                root.menu-layer = -1;
                return accept;
            }
            // En la bienvenida no se cierra con Esc: hay que elegir el volumen.
            if e.text == Key.Escape && !root.welcome {
                root.dismiss();
                return accept;
            }
            reject
        }

        content := VerticalLayout {
            padding: 6px;

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                padding-top: 4px;
                spacing: 6px;
                VerticalLayout {
                    alignment: center;
                    PlayingBars { active: root.playing; }
                }
                Text { text: "Pluvia"; color: Theme.text; font-size: 13px; font-weight: 600; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                Text { text: "v" + root.version; color: Theme.dim; font-size: 11px; vertical-alignment: center; }
            }
            if root.welcome: WelcomeView {
                volume <=> root.volume;
                volume-changed(v) => { root.volume-changed(v); }
                done => { root.welcome-done(); }
            }
            if !root.welcome: VerticalLayout {
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    padding-bottom: 2px;
                    Text {
                        text: root.layers.length == 0 ? "Sin sonidos: agrega uno abajo"
                            : root.mix-label == "" ? "Prende un sonido"
                            : (root.playing ? "Reproduciendo: " : "En pausa: ") + root.mix-label;
                        color: Theme.dim;
                        font-size: 11px;
                        overflow: elide;
                    }
                }

                HorizontalLayout {
                    padding: 8px;
                    spacing: 10px;
                    PlayButton {
                        playing: root.playing;
                        clicked => { root.toggle-play(); }
                    }
                    VolumeSlider {
                        label: "Volumen";
                        value <=> root.volume;
                        changed(v) => { root.volume-changed(v); }
                    }
                    Text {
                        text: round(root.volume * 100) + "%";
                        width: 30px;
                        color: Theme.dim;
                        horizontal-alignment: left;
                        vertical-alignment: center;
                    }
                }

                Separator { }
                HorizontalLayout {
                    padding-left: 8px;
                    padding-bottom: 2px;
                    Text { text: "SONIDOS"; color: Theme.dim; font-size: 10px; font-weight: 600; letter-spacing: 0.6px; }
                }
                // Cada sonido es una capa de la mezcla: el interruptor la prende o apaga, y
                // prendida muestra su propio volumen (apagada ocupa una sola línea).
                // Clic derecho en un sonido: abre el menú contextual (ver `layer-menu` abajo).
                for layer[i] in root.layers: VerticalLayout {
                    MenuRow {
                        text: layer.name;
                        clicked => { root.toggle-layer(i); }
                        right-clicked(mx, my) => {
                            root.menu-layer = i;
                            root.menu-x = self.absolute-position.x + mx;
                            root.menu-y = self.absolute-position.y + my;
                        }
                        VerticalLayout {
                            alignment: center;
                            Toggle { on: layer.on; }
                        }
                    }
                    if layer.on: HorizontalLayout {
                        padding-left: 30px;
                        padding-right: 8px;
                        padding-bottom: 4px;
                        spacing: 8px;
                        layer-slider := VolumeSlider {
                            value: layer.volume;
                            changed(v) => { root.layer-volume-changed(i, v); }
                        }
                        Text {
                            text: round(layer-slider.value * 100) + "%";
                            width: 30px;
                            color: Theme.dim;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                    }
                }
                // Sin límite rígido: es solo un aviso, cada uno decide.
                if root.active-count > 4: HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    padding-top: 2px;
                    padding-bottom: 4px;
                    Text {
                        text: "Más de 4 sonidos a la vez consume más rendimiento.";
                        color: Theme.warning;
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                }
                MenuRow {
                    icon: "+";
                    text: "Agregar audio...";
                    text-color: Theme.dim;
                    clicked => { root.add-audio(); }
                }

                Separator { }
                HorizontalLayout {
                    padding-left: 8px;
                    padding-bottom: 2px;
                    Text { text: "SALIDA"; color: Theme.dim; font-size: 10px; font-weight: 600; letter-spacing: 0.6px; }
                }
                MenuRow {
                    icon: "♪";
                    text: root.current-device == 0
                        ? (root.default-device-name == "" ? "Predeterminado de Windows" : "Predeterminado (" + root.default-device-name + ")")
                        : root.devices[root.current-device - 1];
                    clicked => { root.devices-open = !root.devices-open; }
                    VerticalLayout {
                        alignment: center;
                        Path {
                            width: 8px;
                            height: 5px;
                            commands: root.devices-open ? "M 0 5 L 4 1 L 8 5" : "M 0 0 L 4 4 L 8 0";
                            stroke: Theme.dim;
                            stroke-width: 1.5px;
                        }
                    }
                }
                if root.devices-open: VerticalLayout {
                    padding-left: 14px;
                    MenuRow {
                        icon: root.current-device == 0 ? "✓" : "";
                        text: "Predeterminado de Windows";
                        clicked => { root.select-device(0); }
                    }
                    for device[i] in root.devices: MenuRow {
                        icon: root.current-device == i + 1 ? "✓" : "";
                        text: device;
                        clicked => { root.select-device(i + 1); }
                    }
                }

                Separator { }
                MenuRow {
                    text: "Iniciar con Windows";
                    clicked => { root.toggle-autostart(); }
                    VerticalLayout {
                        alignment: center;
                        Toggle { on: root.autostart; }
                    }
                }
                MenuRow {
                    text: "Abrir carpeta de audios";
                    clicked => { root.open-folder(); }
                }
                MenuRow {
                    text: "Acerca de";
                    clicked => { root.about(); }
                }

                Separator { }
                MenuRow {
                    text: "Salir";
                    text-color: Theme.dim;
                    clicked => { root.quit(); }
                }
            }
        }
    }

    // Menú contextual de un sonido. Se dibuja dentro del mismo panel (no como ventana
    // aparte), así el panel no pierde el foco y no se cierra al abrirlo. Un clic en
    // cualquier otro lado lo cierra.
    if root.menu-layer >= 0: TouchArea {
        width: root.width;
        height: root.height;
        clicked => { root.menu-layer = -1; }
    }
    if root.menu-layer >= 0: layer-menu := Rectangle {
        width: 140px;
        height: 36px;
        x: min(root.menu-x, root.width - self.width - 6px);
        y: min(root.menu-y, root.height - self.height - 6px);
        background: #26262b;
        border-color: Theme.border;
        border-width: 1px;
        border-radius: 6px;
        drop-shadow-blur: 8px;
        drop-shadow-color: #00000080;
        MenuRow {
            x: 4px;
            y: 4px;
            width: parent.width - 8px;
            text: "Eliminar pista";
            text-color: Theme.warning;
            clicked => {
                root.remove-layer(root.menu-layer);
                root.menu-layer = -1;
            }
        }
    }
}
